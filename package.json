async function ortakHavuzuGetir() {
    try {
        let response = await fetch(SUNUCU_URL + '/havuz-json');
        let havuz = await response.json();
        tarananlar = { ...tarananlar, ...havuz };
        chrome.storage.local.set({ tarananlar: tarananlar });
        listeyiGuncelleUI();
    } catch (err) {
        console.log("Sunucuya bağlanılamadı:", err);
    }
}
